# ─────────────────────────────────────────────
# ROS 2 / colcon 빌드 산출물
# ─────────────────────────────────────────────
build/
install/
log/
.colcon/
COLCON_IGNORE

# ─────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
venv/
.venv/

# ─────────────────────────────────────────────
# 실측 결과 — 사람마다/로봇마다 다르므로 커밋하지 않음
#   확정되면 launch 기본값이나 config yaml 에 반영할 것
# ─────────────────────────────────────────────
tools/calib_result.json
tools/calib_result_*.json

# ─────────────────────────────────────────────
# 큰 산출물 — 깃에 넣으면 저장소가 무거워짐
#   데모 영상은 구글드라이브/노션에 두고 링크만 문서에
# ─────────────────────────────────────────────
*.mp4
*.zip
_frames/
*.bag
*.db3
rosbag2_*/

# 맵은 필요하면 예외로 풀 것 (지금은 홈 디렉터리에 있음)
# *.pgm

