    <!-- ================================================================ -->
    <!-- 촬영용 가상 카메라 (8/5 추가)                                     -->
    <!--                                                                  -->
    <!--  목적: 화면 녹화 없이 제출용 영상 소재를 확보한다.                  -->
    <!--                                                                  -->
    <!--  [왜 화면 녹화가 아닌가]                                          -->
    <!--    VirtualBox 에 GPU 가속이 없어 gzclient 3D 렌더링 + 데스크톱     -->
    <!--    합성 + 인코딩이 CPU 를 3중으로 먹는다. 8/4 실측에서 화면 관련   -->
    <!--    프로세스 합계가 136% (rviz 71 + gnome-shell 47 + Xorg 18) 로   -->
    <!--    시뮬레이터(29%)보다 컸고, RTF 가 0.59 까지 떨어졌다.            -->
    <!--                                                                  -->
    <!--  [카메라 센서 방식의 이점]                                        -->
    <!--    프레임을 '시뮬레이션 시간' 기준으로 저장하므로 RTF 가 떨어져도  -->
    <!--    프레임은 균일하게 전부 남는다. 나중에 정상 fps 로 이어붙이면    -->
    <!--    부드러운 영상이 된다.                                          -->
    <!--      RTF 저하 → 후보정으로 회복 가능                              -->
    <!--      FPS 저하 → 회복 불가                                         -->
    <!--    즉 회복 가능한 것을 희생해 회복 불가능한 것을 지킨다.           -->
    <!--                                                                  -->
    <!--  [사용법]                                                        -->
    <!--    1) 프레임 저장 경로를 미리 만든다                              -->
    <!--         mkdir -p /tmp/demo_cam                                    -->
    <!--    2) headless 로 주행 (gui:=false). gzclient·RViz·녹화 전부 끔   -->
    <!--    3) 주행이 끝나면 프레임을 영상으로 합친다                       -->
    <!--         ffmpeg -framerate 20 -pattern_type glob \                 -->
    <!--           -i '/tmp/demo_cam/*.jpg' -c:v libx264 -pix_fmt yuv420p \-->
    <!--           -vf scale=1280:720 ~/demo_overview.mp4                  -->
    <!--                                                                  -->
    <!--  ⚠️ 촬영하지 않을 때는 이 model 블록 전체를 주석 처리할 것.        -->
    <!--    카메라 센서는 렌더링 비용이 있어 SLAM·튜닝 중에는 낭비다.       -->
    <!--    RTF 가 크게 떨어지면 update_rate 나 해상도를 먼저 낮춘다.       -->
    <!-- ================================================================ -->
    <model name="cine_cam_overview">
      <static>true</static>
      <!-- ★ 8/6 재배치 — 기존 (6.0, -10.0, 8.0) 은 복도가 벽에 가려 실패했다.
           [가림 조건] 높이 1.0m 벽 너머 바닥을 보려면
               z_cam > (벽높이 / 벽까지거리) x |y_cam|
             복도 남벽 y=-0.6 기준 계수 1.667 -> z_cam > 1.667 x |y_cam|
             기존값: |y|=10 이므로 16.7m 필요한데 8m 였다 -> 복도 전 구간 가림.
           [현재값] |y|=6 -> 10.0m 필요, z=14.0 이므로 통과.
           위치 (6.2, -6.0, 14.0) 에서 (6.2, 0, 0) 방향 -->
      <pose>6.2000 -6.0000 14.0000 0 1.1659 1.5708</pose>
      <link name="link">
        <!-- 시각 요소 없음: 화면에 카메라 몸체가 안 찍히게 -->
        <sensor name="cam_overview" type="camera">
          <camera>
            <!-- 74.5° — 기본 60° 로는 17m 전경이 다 안 들어온다 -->
            <horizontal_fov>1.3000</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1000</near>
              <far>60.0000</far>
            </clip>
            <save enabled="true">
              <path>/tmp/demo_cam</path>
            </save>
          </camera>
          <always_on>1</always_on>
          <update_rate>20</update_rate>
          <visualize>false</visualize>
        </sensor>
      </link>
    </model>

    <!-- ★ 8/6 추가 — 복도 정면 컷. 이게 '자율주행 영상'의 본 컷이다.
         부감도는 벽 높이(1.0m) 때문에 카메라를 14m 까지 올려야 복도가 보이고,
         그러면 로봇(0.3m)이 화면에서 20픽셀도 안 된다. 즉 부감도로는
         '경로 전체'는 보여줘도 '로봇이 달리는 그림'은 못 만든다.
         -> 카메라를 복도 안(z=0.85, 벽보다 낮게)에 두어 가림을 원천 제거하고,
            로봇이 정면으로 다가오게 한다. 거리가 줄수록 커지므로 역동적이다.
         위치 (7.60, 0, 0.85) 에서 서쪽 (0.5, 0, 0.25) 을 바라봄.
         x=7.60 은 복도 확장부(y +-0.70) 안이라 자유공간이다.
         ⚠️ 로봇 목표(world x 8.6)가 카메라보다 뒤라 로봇이 카메라를 통과한다.
            collision 요소가 없어 물리 간섭은 없다. 편집에서 통과 직전까지만 쓸 것. -->
    <model name="cine_cam_corridor">
      <static>true</static>
      <pose>7.6000 0.0000 0.8500 0 0.0843 3.1416</pose>
      <link name="link">
        <sensor name="cam_corridor" type="camera">
          <camera>
            <horizontal_fov>1.3000</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1000</near>
              <far>30.0000</far>
            </clip>
            <save enabled="true">
              <path>/tmp/demo_cam_corridor</path>
            </save>
          </camera>
          <always_on>1</always_on>
          <update_rate>20</update_rate>
          <visualize>false</visualize>
        </sensor>
      </link>
    </model>

    <!-- 병실 내부 사선 컷 — 침상 접근 장면용.
         8/5 실측: 부감도 카메라 1대의 RTF 비용은 약 0.02 (0.93 -> 0.91).
         2대째도 같은 수준으로 예상하되, RTF 가 0.5 미만이면 한 대를 끌 것.
         병실 남쪽 벽(y=-2.55) 바깥 위쪽에서 내려다보는 컷어웨이 구도.
         벽 높이가 1.0m 라 z=3.5 에서는 벽 너머 내부가 보인다. -->
    <model name="cine_cam_room">
      <static>true</static>
      <!-- ★ 8/6 재배치 — 기존 (8.0, -5.0, 3.5) 은 병실 남벽 바깥이라 가렸다.
           (|y|=5 -> 8.3m 필요한데 3.5m). 카메라를 병실 '안'으로 넣으면
           사이에 벽이 없어 가림 조건 자체가 사라진다.
           병실 남동 모서리 위 (14.0, -2.0, 2.2) 에서 Bed 1 (10.2, 2.05) 방향.
           피사체 거리 약 5.0m -> 침대 2.0m 가 화면 폭의 약 26% 로 잡힌다. -->
      <pose>14.0000 -2.0000 2.2000 0 0.3910 2.4330</pose>
      <link name="link">
        <sensor name="cam_room" type="camera">
          <camera>
            <horizontal_fov>1.3000</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1000</near>
              <far>40.0000</far>
            </clip>
            <save enabled="true">
              <path>/tmp/demo_cam_room</path>
            </save>
          </camera>
          <always_on>1</always_on>
          <update_rate>20</update_rate>
          <visualize>false</visualize>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
